from dataclasses import dataclass
from typing import Any


@dataclass
class AIModel:
    name: str
    version: str = "1.0.0"
    enabled: bool = True

    def predict(self, data: Any) -> dict:
        if data is None:
            raise ValueError("Input data cannot be None")

        return {
            "model": self.name,
            "version": self.version,
            "status": "success",
            "input": data,
        }


if __name__ == "__main__":
    model = AIModel(name="AI-BRAIN")
    print(model.predict({"message": "test"}))
